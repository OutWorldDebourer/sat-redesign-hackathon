# Variables del CLIENTE (prefijo VITE_, expuestas al navegador). NO poner secretos aqui.

# Origen de datos del adapter: "mock" (en memoria) o "real" (backend).
VITE_API_MODE=mock

# Base URL del backend. Vacio = mismo origen (rutas /api en Vercel).
VITE_API_BASE_URL=

# Chat real: por defecto el cliente INTENTA /api/chat y degrada a canned si falla
# (incluido 503 sin clave). Define "false" para forzar solo-canned (sin backend).
VITE_CHAT_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────
# SOLO SERVIDOR — configurar en Vercel > Project > Settings > Environment
# Variables. NUNCA se commitean, no llevan prefijo VITE_ y no se exponen al
# cliente ni a los logs.
#
#   DEEPSEEK_API_KEY=            # obligatoria para activar el chat real
#   DEEPSEEK_MODEL_FAST=deepseek-v4-flash    # opcional: modelo modo normal (default flash)
#   DEEPSEEK_MODEL_THINK=deepseek-v4-flash   # opcional: modelo "modo pensar" (flash con reasoning alto; o deepseek-v4-pro)
#   DEEPSEEK_MODEL=deepseek-v4-flash         # opcional: fallback legacy si no se definen FAST/THINK
#   DEEPSEEK_BASE_URL=https://api.deepseek.com   # opcional (default)
