# Normaliza saltos de linea: LF en el repositorio Y en el working tree, en todas
# las plataformas (evita contaminacion CRLF entre Windows/WSL/CI). Sustituye al
# comportamiento dependiente de core.autocrlf.
* text=auto eol=lf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
